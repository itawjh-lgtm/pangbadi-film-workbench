+def media_metadata(request: dict) -> dict:
+    """Local display fields do not alter the provider payload or spending token."""
+    title = request.get("title", "")
+    media_type = request.get("mediaType", "image")
+    if not isinstance(title, str) or len(title) > 120:
+        raise MediaValidationError("制作任务名称不能超过120字")
+    if not isinstance(media_type, str) or media_type not in {"image", "video"}:
+        raise MediaValidationError("媒体类型只支持image或video")
+    return {"title": title.strip(), "mediaType": media_type}
+
+
+def media_event(job: dict, kind: str, text: str, at: int) -> None:
+    """Record observed lifecycle events; never manufacture intermediate stages."""
+    history = job.setdefault("history", [])
+    history.append({"id": uuid.uuid4().hex, "type": kind,
+                    "status": job["status"], "text": text[:500], "at": at})
+    if len(history) > 100:
+        job["history"] = history[:1] + history[-99:]
+
+
+def external_media_fields(request: dict) -> dict:
+    """Validate a user-registered link without fetching, probing or downloading."""
+    allowed = {"requestId", "projectId", "title", "mediaType", "url", "sourceUrl", "taskId"}
+    if set(request) - allowed:
+        raise MediaValidationError("外部结果登记包含不支持的字段")
+    metadata = media_metadata(request)
+    if not metadata["title"] or "mediaType" not in request:
+        raise MediaValidationError("请填写结果名称并选择图片或视频")
+    url = _safe_url(request.get("url"))
+    source_url = request.get("sourceUrl") or None
+    if not url or (source_url is not None and not _safe_url(source_url)):
+        raise MediaValidationError("请填写公开HTTPS链接，不能使用本机、内网或含账号密码的地址")
+    task_id = request.get("taskId") or None
+    if task_id is not None:
+        _identifier(task_id, "平台任务编号")
+    return {**metadata, "source": "external", "provider": "external", "sourceUrl": source_url,
+            "externalTaskId": task_id, "status": "succeeded",
+            "outputs": [{"url": url, "outputType": metadata["mediaType"],
